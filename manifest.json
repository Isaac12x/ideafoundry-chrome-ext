{
  "manifest_version": 3,
  "name": "IdeaFoundry · Conversation capture",
  "version": "0.3.6",
  "description": "Save LLM conversations as Markdown or PDF, or send them directly to your IdeaFoundry knowledge base.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "alarms", "offscreen"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Open IdeaFoundry capture widget" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
